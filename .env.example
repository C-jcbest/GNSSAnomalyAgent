# Fill locally; never commit .env. Both URLs must include the provider's correct base path.
BEIDOU_API_BASE_URL=
BEIDOU_USERNAME=
BEIDOU_PASSWORD=
QWEN_BASE_URL=
QWEN_API_KEY=
# Only calculate currency cost when this matches the requested model and prices are set.
QWEN_PRICE_MODEL=qwen3.8-flash
# Optional: monetary cost per million tokens (unknown cost remains null, never zero).
QWEN_INPUT_PRICE_PER_MILLION=
QWEN_OUTPUT_PRICE_PER_MILLION=
