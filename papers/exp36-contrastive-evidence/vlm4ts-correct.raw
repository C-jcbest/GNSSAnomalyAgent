<td id="Sx4.T3.1.1.8.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx4.T3.1.1.8.2.1" class="ltx_text ltx_font_bold">0.649</span></td>
<td id="Sx4.T3.1.1.8.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx4.T3.1.1.8.3.1" class="ltx_text ltx_font_bold">0.696</span></td>
<td id="Sx4.T3.1.1.8.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx4.T3.1.1.8.4.1" class="ltx_text ltx_font_bold">0.651</span></td></tr>
