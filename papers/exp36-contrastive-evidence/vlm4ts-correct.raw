<div id="A2.T15.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:505.9pt;height:147.5pt;vertical-align:-71.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-40.0pt,11.7pt) scale(0.863333394267149,0.863333394267149) ;">
