<td id="A2.T7.1.1.2.8" class="ltx_td ltx_align_center ltx_border_t">0.01</td>
<td id="A2.T7.1.1.2.9" class="ltx_td ltx_align_center ltx_border_t">0.001</td></tr>
<tr id="A2.T7.1.1.3" class="ltx_tr">
<td id="A2.T7.1.1.3.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="A2.T7.1.1.3.1.1" class="ltx_text">ViT4TS</span></td>
