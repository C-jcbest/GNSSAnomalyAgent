<td id="A2.T7.1.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" rowspan="2"><span id="A2.T7.1.1.1.2.1" class="ltx_text ltx_font_bold">Metric</span></td>
<td id="A2.T7.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="A2.T7.1.1.1.3.1" class="ltx_text ltx_font_bold">MSL</span></td>
<td id="A2.T7.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="A2.T7.1.1.1.4.1" class="ltx_text ltx_font_bold">SMAP</span></td>
<td id="A2.T7.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="A2.T7.1.1.1.5.1" class="ltx_text ltx_font_bold">Tweets</span></td></tr>
<tr id="A2.T7.1.1.2" class="ltx_tr">
<td id="A2.T7.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t">0.1</td>
