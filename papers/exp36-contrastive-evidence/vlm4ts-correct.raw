<tr id="A2.T6.1.1.3" class="ltx_tr">
<td id="A2.T6.1.1.3.1" class="ltx_td ltx_align_left"><span id="A2.T6.1.1.3.1.1" class="ltx_text ltx_font_typewriter">AER</span></td>
<td id="A2.T6.1.1.3.2" class="ltx_td ltx_align_center">20.25</td>
<td id="A2.T6.1.1.3.3" class="ltx_td ltx_align_center">21.70</td>
<td id="A2.T6.1.1.3.4" class="ltx_td ltx_align_center">24.08</td>
<td id="A2.T6.1.1.3.5" class="ltx_td ltx_align_center">24.55</td>
