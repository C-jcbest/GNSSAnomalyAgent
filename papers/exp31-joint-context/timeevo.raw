<th id="A4.T5.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;" colspan="2"><span id="A4.T5.2.1.3.1" class="ltx_text ltx_font_bold">Harmed</span></th></tr>
