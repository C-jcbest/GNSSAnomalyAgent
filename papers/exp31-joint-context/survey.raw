<span id="A6.T3.4.1.4.5.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="A6.T3.4.1.4.5.1.1" class="ltx_p ltx_align_left">Multi (Cooperative)</span>
</span></td>
<td id="A6.T3.4.1.4.6" class="ltx_td ltx_align_left ltx_align_top" style="padding:-0.75pt 2.0pt;">
<span id="A6.T3.4.1.4.6.1" class="ltx_inline-block ltx_align_top" style="width:102.4pt;">
