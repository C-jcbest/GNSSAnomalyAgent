<td id="S4.T1.6.1.3.6" class="ltx_td ltx_align_center" style="padding:0.6pt 3.5pt;">0.1008</td>
<td id="S4.T1.6.1.3.7" class="ltx_td ltx_align_center" style="padding:0.6pt 3.5pt;">0.0991</td>
<td id="S4.T1.6.1.3.8" class="ltx_td ltx_align_center" style="padding:0.6pt 3.5pt;">0.0930</td>
<td id="S4.T1.6.1.3.9" class="ltx_td ltx_align_center" style="padding:0.6pt 3.5pt;">0.0951</td>
