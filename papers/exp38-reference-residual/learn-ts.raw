<th id="S4.T1.6.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding:0.6pt 3.5pt;">Metric</th>
<th id="S4.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 3.5pt;">Omni</th>
<th id="S4.T1.6.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.6pt 3.5pt;">A.T.</th>
