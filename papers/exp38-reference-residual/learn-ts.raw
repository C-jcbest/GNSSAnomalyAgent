<tr id="A2.T4.2.11" class="ltx_tr">
<td id="A2.T4.2.11.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Weight decay</td>
<td id="A2.T4.2.11.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A2.T4.m5" class="ltx_Math" alttext="1\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A2.T4.2.12" class="ltx_tr">
<td id="A2.T4.2.12.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Gradient clipping</td>
<td id="A2.T4.2.12.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">1.0</td></tr>
<tr id="A2.T4.2.13" class="ltx_tr">
<td id="A2.T4.2.13.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Initial learning rate</td>
<td id="A2.T4.2.13.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A2.T4.m6" class="ltx_Math" alttext="5\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-5}</annotation></semantics></math><sup id="A2.T4.2.13.2.1" class="ltx_sup"><span id="A2.T4.2.13.2.1.1" class="ltx_text ltx_font_italic">†</span></sup></td></tr>
<tr id="A2.T4.2.14" class="ltx_tr">
<td id="A2.T4.2.14.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Minimum learning rate</td>
<td id="A2.T4.2.14.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A2.T4.m8" class="ltx_Math" alttext="1\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-6}</annotation></semantics></math></td></tr>
<tr id="A2.T4.2.15" class="ltx_tr">
<td id="A2.T4.2.15.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Early-stopping patience</td>
