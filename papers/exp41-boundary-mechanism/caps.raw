<th id="A4.T14.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 5.0pt;"><span id="A4.T14.4.1.1.2.1" class="ltx_text" style="font-size:90%;">Affiliation-F</span></th>
