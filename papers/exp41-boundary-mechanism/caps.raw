<td id="A4.T18.4.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A4.T18.4.2.2.1" class="ltx_text" style="font-size:90%;">77.66</span></td>
