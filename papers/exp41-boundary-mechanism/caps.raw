<td id="A4.T9.4.14.2" class="ltx_td ltx_align_center" style="padding:0.25pt 7.0pt;"><span id="A4.T9.4.14.2.1" class="ltx_text" style="font-size:90%;">73.60</span></td>
<td id="A4.T9.4.14.3" class="ltx_td ltx_align_center" style="padding:0.25pt 7.0pt;"><span id="A4.T9.4.14.3.1" class="ltx_text" style="font-size:90%;">27.00</span></td>
<td id="A4.T9.4.14.4" class="ltx_td ltx_align_center" style="padding:0.25pt 7.0pt;"><span id="A4.T9.4.14.4.1" class="ltx_text" style="font-size:90%;">22.60</span></td>
<td id="A4.T9.4.14.5" class="ltx_td ltx_align_center" style="padding:0.25pt 7.0pt;"><span id="A4.T9.4.14.5.1" class="ltx_text" style="font-size:90%;">75.90</span></td></tr>
