<th id="A4.T17.4.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 5.0pt;"><span id="A4.T17.4.1.5.1" class="ltx_text" style="font-size:90%;">VUS-PR</span></th></tr>
</thead>
<tbody class="ltx_tbody">
