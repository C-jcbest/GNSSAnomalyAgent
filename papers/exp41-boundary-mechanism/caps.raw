<th id="A4.T15.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 8.0pt;"><span id="A4.T15.5.1.2.1" class="ltx_text" style="font-size:90%;">Score <math id="A4.T15.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
<th id="A4.T15.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 8.0pt;"><span id="A4.T15.5.1.3.1" class="ltx_text" style="font-size:90%;">Feature <math id="A4.T15.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T15.5.2" class="ltx_tr">
<th id="A4.T15.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.25pt 8.0pt;"><span id="A4.T15.5.2.1.1" class="ltx_text" style="font-size:90%;">Rule-based injection</span></th>
<td id="A4.T15.5.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 8.0pt;"><span id="A4.T15.5.2.2.1" class="ltx_text" style="font-size:90%;">0.4531</span></td>
<td id="A4.T15.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 8.0pt;"><span id="A4.T15.5.2.3.1" class="ltx_text" style="font-size:90%;">0.6218</span></td></tr>
<tr id="A4.T15.5.3" class="ltx_tr">
