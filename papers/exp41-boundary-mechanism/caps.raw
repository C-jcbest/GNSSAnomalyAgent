<td id="A4.T18.4.3.5" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A4.T18.4.3.5.1" class="ltx_text" style="font-size:90%;">46.53</span></td></tr>
