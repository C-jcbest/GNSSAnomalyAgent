<td id="A4.T14.4.1.3.3" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;"><span id="A4.T14.4.1.3.3.1" class="ltx_text" style="font-size:90%;">42.32</span></td>
<td id="A4.T14.4.1.3.4" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;"><span id="A4.T14.4.1.3.4.1" class="ltx_text" style="font-size:90%;">38.82</span></td>
<td id="A4.T14.4.1.3.5" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;"><span id="A4.T14.4.1.3.5.1" class="ltx_text" style="font-size:90%;">42.63</span></td></tr>
