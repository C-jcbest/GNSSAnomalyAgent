<th id="A4.T6.4.1.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 4.0pt;"><span id="A4.T6.4.1.1.8.1" class="ltx_text" style="font-size:90%;">UCR</span></th>
