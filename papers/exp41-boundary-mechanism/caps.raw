<td id="A4.T19.4.1.4.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A4.T19.4.1.4.2.1" class="ltx_text" style="font-size:90%;">95.1 min</span></td>
