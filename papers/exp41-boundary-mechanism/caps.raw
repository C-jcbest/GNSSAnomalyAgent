<th id="A2.T3.2.19.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.25pt 5.0pt;"><span id="A2.T3.2.19.1.1" class="ltx_text" style="font-size:90%;">Residual-generation epochs</span></th>
<td id="A2.T3.2.19.2" class="ltx_td ltx_align_left" style="padding:0.25pt 5.0pt;"><span id="A2.T3.2.19.2.1" class="ltx_text" style="font-size:90%;">100</span></td></tr>
