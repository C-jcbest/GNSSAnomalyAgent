<td id="A4.T9.4.12.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 7.0pt;"><span id="A4.T9.4.12.4.1" class="ltx_text" style="font-size:90%;">22.54</span></td>
