<td id="A5.T22.5.1.20.10" class="ltx_td ltx_align_center" style="padding:0.7pt 4.0pt;"><math id="A5.T22.m174" class="ltx_Math" alttext="43.27\pm 0.73" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">43.27</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.73</mn></mrow><annotation encoding="application/x-tex">43.27\pm 0.73</annotation></semantics></math></td>
