<td id="A4.T18.4.4.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A4.T18.4.4.2.1" class="ltx_text" style="font-size:90%;">41.05</span></td>
<td id="A4.T18.4.4.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A4.T18.4.4.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">43.52</span></td>
