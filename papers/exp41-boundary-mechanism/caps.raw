<td id="A4.T8.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 5.0pt;"><span id="A4.T8.4.1.2.5.1" class="ltx_text" style="font-size:90%;">42.58</span></td></tr>
